{
 "id": "ros-linux-processes",
 "check": {
  "task": [
   {
    "t": "p",
    "c": [
     {
      "t": "text",
      "v": "Answer in five or six sentences, without notes, in 10 minutes:"
     }
    ]
   },
   {
    "t": "ul",
    "items": [
     [
      {
       "t": "text",
       "v": "What happens when you press Ctrl+C in a terminal while a program runs?"
      }
     ],
     [
      {
       "t": "text",
       "v": "What does that program do by default?"
      }
     ],
     [
      {
       "t": "text",
       "v": "What does "
      },
      {
       "t": "code",
       "v": "echo $?"
      },
      {
       "t": "text",
       "v": " print right afterwards, and why that number?"
      }
     ],
     [
      {
       "t": "text",
       "v": "What should a program that must save its work do instead?"
      }
     ]
    ]
   }
  ],
  "answer": [
   {
    "t": "ol",
    "items": [
     [
      {
       "t": "text",
       "v": "The terminal sends the signal "
      },
      {
       "t": "b",
       "v": "SIGINT"
      },
      {
       "t": "text",
       "v": " (number 2) to every process in the foreground process group."
      }
     ],
     [
      {
       "t": "text",
       "v": "The default action for SIGINT is to terminate the process."
      }
     ],
     [
      {
       "t": "text",
       "v": "The shell then reports the exit status as "
      },
      {
       "t": "b",
       "v": "128 + the signal number"
      },
      {
       "t": "text",
       "v": ", so "
      },
      {
       "t": "code",
       "v": "echo $?"
      },
      {
       "t": "text",
       "v": " prints "
      },
      {
       "t": "b",
       "v": "130"
      },
      {
       "t": "text",
       "v": "."
      }
     ],
     [
      {
       "t": "text",
       "v": "A program that must save its work installs a handler that "
      },
      {
       "t": "b",
       "v": "only sets a flag"
      },
      {
       "t": "text",
       "v": ". Its main loop checks the flag, stops, cleans up in normal code and returns 0, or whatever status it chooses."
      }
     ]
    ]
   },
   {
    "t": "p",
    "c": [
     {
      "t": "text",
      "v": "ROS 2 does exactly this: "
     },
     {
      "t": "code",
      "v": "rclcpp::init"
     },
     {
      "t": "text",
      "v": " installs a SIGINT handler, and "
     },
     {
      "t": "code",
      "v": "rclcpp::ok()"
     },
     {
      "t": "text",
      "v": " turns false."
     }
    ]
   },
   {
    "t": "p",
    "c": [
     {
      "t": "b",
      "v": "Pass:"
     },
     {
      "t": "text",
      "v": " all four points, including 130. "
     },
     {
      "t": "b",
      "v": "Partly:"
     },
     {
      "t": "text",
      "v": " you missed 130 or the \"only set a flag\" rule. "
     },
     {
      "t": "b",
      "v": "Fail:"
     },
     {
      "t": "text",
      "v": " more."
     }
    ]
   }
