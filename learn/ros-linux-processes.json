 },
 "subs": [
  {
   "id": "processes",
   "title": "Processes, ps, top, kill, signals, exit status",
   "steps": [
    {
     "kind": "theory",
     "heading": "Theory",
     "minutes": 20,
     "blocks": [
      {
       "t": "p",
       "c": [
        {
         "t": "text",
         "v": "A "
        },
        {
         "t": "b",
         "v": "process"
        },
        {
         "t": "text",
         "v": " is a running program. It has:"
        }
       ]
      },
      {
       "t": "ul",
       "items": [
        [
         {
          "t": "text",
          "v": "a process id (PID) and a parent (PPID);"
         }
        ],
        [
         {
          "t": "text",
          "v": "its own memory;"
         }
        ],
        [
         {
          "t": "text",
          "v": "open files, including stdin, stdout and stderr;"
         }
        ],
        [
         {
          "t": "text",
          "v": "a state, which "
         },
         {
          "t": "code",
          "v": "ps"
         },
         {
          "t": "text",
          "v": " shows as "
         },
         {
          "t": "code",
          "v": "R"
         },
         {
          "t": "text",
          "v": " running, "
         },
         {
          "t": "code",
          "v": "S"
         },
         {
          "t": "text",
          "v": " sleeping, "
         },
         {
          "t": "code",
          "v": "T"
         },
         {
          "t": "text",
          "v": " stopped or "
         },
         {
          "t": "code",
          "v": "Z"
         },
         {
          "t": "text",
          "v": " zombie."
         }
        ]
       ]
      },
      {
       "t": "p",
       "c": [
        {
         "t": "text",
         "v": "Every process except PID 1 has a parent. When a process ends, its "
        },
        {
         "t": "b",
         "v": "exit status"
        },
        {
         "t": "text",
         "v": " waits until the parent collects it with "
        },
        {
         "t": "code",
         "v": "wait()"
        },
        {
         "t": "text",
         "v": ". A shell is such a parent: it collects the status and shows it in "
        },
        {
         "t": "code",
         "v": "$?"
        },
        {
         "t": "text",
         "v": "."
        }
       ]
      },
      {
       "t": "p",
       "c": [
        {
         "t": "b",
         "v": "Exit status"
        },
        {
         "t": "text",
         "v": " is a number from 0 to 255. 0 means success, and anything else is a failure whose meaning the program defines. When a signal kills a process, the shell reports 128 + the signal number."
        }
       ]
      },
      {
       "t": "p",
       "c": [
        {
         "t": "text",
         "v": "A "
        },
        {
         "t": "b",
         "v": "signal"
        },
        {
         "t": "text",
         "v": " is an asynchronous notification sent to a process. The ones you will meet:"
        }
       ]
      },
      {
       "t": "table",
       "head": [
        [
         {
          "t": "text",
          "v": "Signal"
         }
        ],
        [
         {
          "t": "text",
          "v": "Number"
         }
        ],
        [
         {
          "t": "text",
          "v": "Sent by"
         }
        ],
        [
         {
          "t": "text",
          "v": "Default"
         }
        ],
        [
         {
          "t": "text",
          "v": "Can be caught?"
         }
        ]
       ],
       "rows": [
        [
         [
          {
           "t": "text",
           "v": "SIGINT"
          }
         ],
         [
          {
           "t": "text",
           "v": "2"
          }
         ],
         [
          {
           "t": "text",
           "v": "Ctrl+C in the terminal"
          }
         ],
         [
          {
           "t": "text",
           "v": "terminate"
          }
         ],
         [
          {
           "t": "text",
           "v": "yes"
          }
         ]
        ],
        [
         [
          {
           "t": "text",
           "v": "SIGTERM"
          }
         ],
         [
          {
           "t": "text",
           "v": "15"
          }
         ],
         [
          {
           "t": "code",
           "v": "kill PID"
          },
          {
           "t": "text",
           "v": ", systemd, "
          },
          {
           "t": "code",
           "v": "docker stop"
          },
          {
           "t": "text",
           "v": ", "
          },
          {
           "t": "code",
           "v": "ros2 launch"
          },
          {
           "t": "text",
