          }
         ],
         [
          {
           "t": "text",
           "v": "yes"
          }
         ]
        ],
        [
         [
          {
           "t": "text",
           "v": "SIGKILL"
          }
         ],
         [
          {
           "t": "text",
           "v": "9"
          }
         ],
         [
          {
           "t": "code",
           "v": "kill -9 PID"
          },
