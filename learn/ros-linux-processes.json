          }
         ],
         [
          {
           "t": "b",
           "v": "no"
          }
         ]
        ],
        [
         [
          {
           "t": "text",
           "v": "SIGSEGV"
          }
         ],
         [
          {
           "t": "text",
           "v": "11"
          }
         ],
         [
          {
           "t": "text",
           "v": "the kernel, on an invalid memory access"
          }
         ],
         [
          {
           "t": "text",
           "v": "terminate with a core dump"
          }
         ],
         [
          {
           "t": "text",
           "v": "yes, but don't"
          }
         ]
        ],
        [
         [
          {
           "t": "text",
           "v": "SIGABRT"
          }
         ],
         [
          {
           "t": "text",
           "v": "6"
          }
         ],
         [
          {
           "t": "code",
           "v": "abort()"
          },
          {
           "t": "text",
           "v": ", a failed "
          },
          {
           "t": "code",
           "v": "assert"
          },
          {
           "t": "text",
           "v": ", the sanitizers"
          }
         ],
         [
          {
           "t": "text",
           "v": "terminate with a core dump"
          }
         ],
         [
          {
           "t": "text",
           "v": "yes, but don't"
          }
         ]
        ],
        [
         [
          {
           "t": "text",
           "v": "SIGCHLD"
          }
         ],
         [
          {
           "t": "text",
           "v": "17"
          }
         ],
         [
          {
           "t": "text",
           "v": "the kernel, when a child stops or exits"
          }
         ],
         [
          {
           "t": "text",
           "v": "ignore"
          }
         ],
         [
          {
           "t": "text",
           "v": "yes"
          }
         ]
        ],
        [
         [
          {
           "t": "text",
           "v": "SIGHUP"
          }
         ],
         [
          {
           "t": "text",
           "v": "1"
          }
         ],
         [
          {
           "t": "text",
           "v": "the terminal closing"
          }
         ],
         [
          {
           "t": "text",
           "v": "terminate"
          }
         ],
         [
          {
           "t": "text",
           "v": "yes"
          }
         ]
        ]
       ]
      },
      {
       "t": "p",
       "c": [
        {
         "t": "text",
         "v": "The shell commands to know:"
        }
       ]
      },
      {
       "t": "code",
       "lang": "sh",
       "tag": "",
       "expect": "",
       "text": "ps -ef                                   # every process, with PID and PPID\nps -o pid,ppid,stat,rss,cmd -p 1234      # one process: state, resident memory in KB, command\npgrep -a talker                          # find processes by name\ntop                                      # live CPU and memory; press M to sort by memory\nkill -TERM 1234                          # ask a process to stop (the default signal)\nkill -INT 1234                           # the same signal as Ctrl+C\nkill -KILL 1234                          # force: no clean-up is possible\ncat /proc/1234/status                    # the kernel's view: state, threads, memory\njournalctl -k | grep -i \"out of memory\"  # was it killed by the OOM killer?"
      },
      {
       "t": "p",
       "c": [
        {
         "t": "text",
         "v": "A small session that shows exit statuses:"
        }
       ]
      },
      {
       "t": "code",
       "lang": "sh",
       "tag": "",
       "expect": "",
       "text": "sleep 100 &                  # run in the background; $! is its PID\nps -o pid,ppid,stat,cmd -p $!\nkill -TERM $!                # ask it to stop\nwait $!; echo $?             # 143 = 128 + 15\nfalse; echo $?               # 1: an ordinary failure"
      },
      {
       "t": "p",
       "c": [
        {
         "t": "text",
         "v": "Why this matters for robotics: every ROS 2 node is a process. "
        },
        {
         "t": "code",
         "v": "ros2 launch"
        },
        {
         "t": "text",
         "v": " starts several and, when you press Ctrl+C, sends each of them SIGINT. Then it escalates to SIGTERM and finally SIGKILL for nodes that don't stop in time. A node that ignores shutdown gets killed without cleaning up."
        }
       ]
      }
     ]
    }
   ]
